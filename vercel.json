{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/dashboard/orders/(.*)",
      "dest": "/order-detail.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
